# Required for AI-assisted mod authoring (chat + propose_file_edit tool calls).
ANTHROPIC_API_KEY="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"

# Optional: override the chat model (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# "dryrun" (default) uses LocalDryRunBuildService/LocalDryRunDecompileService —
# no Docker required, safe for local dev and this environment's sandbox.
# "docker" uses the real DockerBuildService/DockerDecompileService and needs a
# reachable Docker daemon plus network access to Fabric's Maven repositories.
BUILD_SERVICE=dryrun

# Image name for the real Docker build/decompile pipeline (see docker/builder).
DOCKER_BUILDER_IMAGE=mc-mod-builder:latest

# Where the SQLite DB and build/decompile-cache storage live (defaults to
# ./data and ./storage under the project root).
DATA_DIR=
STORAGE_DIR=
